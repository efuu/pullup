{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "paths": {
      "@design/*": [
        "../design/*"
      ]
    }
  },
  "include": [
    "src",
    "../generated",
    "../src/text.d.ts"
  ]
}
